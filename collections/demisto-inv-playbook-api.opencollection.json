              {
                "name": "investigationId",
                "value": "",
                "type": "path",
                "description": "investigation ID"
              }
            ]
          },
          "docs": "Edit an ad-hoc task in a running playbook"
        },
        {
          "info": {
            "name": "Task add comment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/inv-playbook/task/note/add"
          },
          "docs": "Add comment to a task"
        },
        {
          "info": {
            "name": "Un complete a task",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/inv-playbook/task/uncomplete"
