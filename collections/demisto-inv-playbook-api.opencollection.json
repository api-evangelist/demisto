          "docs": "Reopen a closed task and change the status to uncomplete"
        },
        {
          "info": {
            "name": "Complete a task",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v2/inv-playbook/task/complete"
          },
          "docs": "Complete a task with command and multiple file attachments"
