          },
          "docs": "Edit an indicator entity\nTo update indicator custom fields you should lowercase them and remove all spaces. For example: Scan IP -> scanip"
        },
        {
          "info": {
            "name": "Whitelists or deletes Indicator",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/indicator/whitelist"
          },
          "docs": "Whitelists or deletes an indicator entity\nIn order to delete an indicator and not whitelist, set doNotWhitelist boolean field to true"
        }
      ]
